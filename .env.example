# Copy this file to ".env" and fill it in yourself. Never paste keys into a chat.
#
# With no keys the bot runs in DRY-RUN mode: free Yahoo data, simulated fills.
# With paper keys it trades your Alpaca PAPER account.

ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Paper trading is the default. Leave this as "true" unless you mean it.
ALPACA_PAPER=true

# Live trading needs BOTH: ALPACA_PAPER=false above AND the exact phrase below.
# LIVE_TRADING_CONFIRM=I-ACCEPT-THE-RISK
LIVE_TRADING_CONFIRM=

# Optional. SEC asks automated clients to identify themselves ("Name email").
# Only when this is set will the dashboard show fresh 8-K filings.
SEC_USER_AGENT=
